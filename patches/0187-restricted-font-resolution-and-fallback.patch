+
+bool FontCache::IsUxrFontFamilyAllowed(const String& family) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (config.Get("uxr-font-policy") != "restricted")
+    return true;
+  const std::string actual = family.Utf8();
+  for (const auto& entry : base::SplitString(config.Get("uxr-font-whitelist"), ",",
+                                            base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    if (base::EqualsCaseInsensitiveASCII(entry, actual))
+      return true;
+  }
+  return false;
+}
+
+const SimpleFontData* FontCache::UxrRestrictedLastResortFont(
+    const FontDescription& description) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (config.Get("uxr-font-policy") != "restricted")
+    return nullptr;
+  for (const auto& entry : base::SplitString(config.Get("uxr-font-whitelist"), ",",
+                                            base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    if (const auto* data = GetFontData(description, AtomicString(String::FromUtf8(entry)),
+                                       AlternateFontName::kNoAlternate))
+      return data;
+  }
+  // A missing installed pool must not fall back to an excluded host font, or
+  // leave Blink's mandatory last-resort font null. Skia's empty face has no
+  // host glyphs and keeps this failure bounded; no real font is fabricated.
+  const auto* empty = MakeGarbageCollected<FontPlatformData>(
+      SkTypeface::MakeEmpty(), std::string(), description.EffectiveFontSize(),
+      false, false, description.TextRendering(), ResolvedFontFeatures(),
+      description.Orientation());
+  return FontDataFromFontPlatformData(empty, description.SubpixelAscentDescent());
 }
 
