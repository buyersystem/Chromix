+bool ValidateWebPreferences(const flat_map<std::string, std::string>& cfg) {
+  const auto allowed = [&](const char* key,
+                           std::initializer_list<std::string_view> values) {
+    auto it = cfg.find(key);
+    if (it == cfg.end())
+      return true;
+    for (std::string_view value : values)
+      if (it->second == value)
+        return true;
+    return false;
+  };
+  for (const char* key : {"uxr-reduced-motion", "uxr-reduced-transparency",
+                          "uxr-inverted-colors"}) {
+    if (!allowed(key, {"true", "false", "1", "0"}))
+      return false;
+  }
+  if (!allowed("uxr-color-scheme", {"dark", "light"}) ||
+      !allowed("uxr-preferred-contrast", {"more", "less", "no-preference"}) ||
+      !allowed("uxr-forced-colors", {"active", "none", "true", "false", "1", "0"}) ||
+      !allowed("uxr-pointer", {"fine", "coarse", "none"}) ||
+      !allowed("uxr-hover", {"hover", "none"}) ||
+      !allowed("uxr-hdr", {"native"})) {
+    return false;
+  }
+  int touch = -1;
+  // These new launch switches use the same decimal syntax as both SDKs.
+  for (const char* key : {"uxr-max-touch-points", "uxr-timer-resolution"}) {
+    if (auto it = cfg.find(key); it != cfg.end() &&
+        (it->second.empty() ||
+         it->second.find_first_not_of("0123456789") != std::string::npos))
+      return false;
+  }
+  if (!ReadDimension(cfg, "uxr-max-touch-points", &touch, 0, 16))
+    return false;
+  const auto pointer = cfg.find("uxr-pointer");
+  if (pointer != cfg.end()) {
+    if ((pointer->second == "none" && touch > 0) ||
+        (pointer->second == "coarse" && touch == 0))
+      return false;
+    if (auto hover = cfg.find("uxr-hover"); hover != cfg.end() &&
+        pointer->second == "none" && hover->second == "hover")
+      return false;
+  }
+  // Changing a layout map alone does not change the platform key mapping.
+  if (auto keyboard = cfg.find("uxr-keyboard-layout"); keyboard != cfg.end() &&
+      keyboard->second != "native") {
+    auto synthetic = cfg.find("uxr-synthetic-device-tests");
+    if (synthetic == cfg.end() || synthetic->second != "true" ||
+        (keyboard->second != "us" && keyboard->second != "en-US"))
+      return false;
+  }
+  return true;
+}
+
+bool ValidateCodecPolicy(const flat_map<std::string, std::string>& cfg) {
+  for (const char* key : {"uxr-codec-h264", "uxr-codec-vp8", "uxr-codec-vp9",
+                          "uxr-codec-av1", "uxr-codec-hevc"}) {
+    const auto it = cfg.find(key);
+    if (it == cfg.end() || it->second.empty() || it->second == "disabled" ||
+        it->second == "native")
+      continue;
+    std::string_view remaining = it->second;
+    bool supported = false;
+    while (!remaining.empty()) {
+      const auto comma = remaining.find(',');
+      const auto token = remaining.substr(0, comma);
+      if (token == "supported")
+        supported = true;
+      else if (token != "smooth" && token != "power-efficient")
+        return false;
+      if (comma == std::string_view::npos)
+        break;
+      remaining.remove_prefix(comma + 1);
+      if (remaining.empty())
+        return false;
+    }
+    if (!supported)
+      return false;
+  }
+  return true;
+}
+
+bool ParseAudioIsolation(const flat_map<std::string, std::string>& cfg,
+                        uint64_t* seed) {
+  const auto valid_seed = [](const std::string& text, uint64_t* out) {
+    return !text.empty() && text.find_first_not_of("0123456789") == std::string::npos &&
+           StringToUint64(text, out) && *out != 0;
+  };
+  uint64_t parsed = 0;
+  auto value = cfg.find("uxr-audio-seed");
+  if (value != cfg.end() && !valid_seed(value->second, &parsed))
+    return false;
+  auto mode = cfg.find("uxr-audio-render");
+  if (mode == cfg.end() || mode->second == "native")
+    return true;
+  if (mode->second != "isolated")
+    return false;
+  if (value == cfg.end())
+    value = cfg.find("uxr-fingerprint-seed");
+  if (value == cfg.end() || !valid_seed(value->second, &parsed))
+    return false;
+  if (!cfg.contains("uxr-disable-fingerprint-noise"))
+    *seed = parsed;
+  return true;
+}
+
+bool ValidateFontPolicy(const flat_map<std::string, std::string>& cfg) {
+  auto mode = cfg.find("uxr-font-policy");
+  if (mode == cfg.end() || mode->second == "native")
+    return true;
+  if (mode->second != "restricted")
+    return false;
+  auto families = cfg.find("uxr-font-whitelist");
+  if (families == cfg.end() || families->second.empty())
+    return false;
+  std::string_view remaining = families->second;
+  size_t count = 0;
+  while (!remaining.empty()) {
+    const auto comma = remaining.find(',');
+    const auto family = remaining.substr(0, comma);
+    if (++count > 256 || family.find_first_not_of(" \t") == std::string_view::npos)
+      return false;
+    for (unsigned char c : family)
+      if ((c < 0x20 && c != '\t') || c == 0x7f)
+        return false;
+    if (comma == std::string_view::npos)
+      return true;
+    remaining.remove_prefix(comma + 1);
+  }
+  return false;
+}
