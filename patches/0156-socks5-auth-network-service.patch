+// Browser-launch-scoped configuration inherited by the network service. Keep
+// credentials out of argv and bind them to one canonical proxy endpoint; this
+// is not an HTTP-auth cache and must not answer origin authentication prompts.
+int ReadSocks5Credentials(
+    const TransportSocketParams::Endpoint& destination,
+    std::optional<SOCKS5ClientSocket::Credentials>* credentials) {
+  auto raw = base::Environment::Create()->GetVar("CHROMIX_SOCKS5_AUTH");
+  if (!raw || raw->empty()) {
+    return OK;
+  }
+  if (raw->size() > 4096) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  auto value = base::JSONReader::ReadDict(*raw, base::JSON_PARSE_RFC);
+  if (!value || value->size() != 5 || value->FindInt("version") != 1) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  const auto* host = value->FindString("host");
+  const auto port = value->FindInt("port");
+  const auto* username = value->FindString("username");
+  const auto* password = value->FindString("password");
+  if (!host || !port || *port <= 0 || *port > 65535 || !username || !password ||
+      username->empty() || username->size() > 255 || password->empty() ||
+      password->size() > 255) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  const auto server = ProxyServer::FromSchemeHostAndPort(
+      ProxyServer::SCHEME_SOCKS5, *host, static_cast<uint16_t>(*port));
+  const auto* endpoint = std::get_if<HostPortPair>(&destination);
+  if (!server.is_valid() || !endpoint) {
+    return ERR_INVALID_ARGUMENT;
+  }
+  if (server.host_port_pair() == *endpoint) {
+    *credentials = SOCKS5ClientSocket::Credentials{*username, *password};
+  }
+  return OK;
+}
+
