-// Opaque canvas uploads must contain opaque alpha bytes, not merely carry
-// kOpaque metadata. Otherwise native CPU/GPU/export paths can reinterpret
-// untouched ImageData alpha as premultiplication and corrupt the same pixels.
+struct UxrOpaqueAlpha {
+  std::array<uint8_t, 4> bytes{};
+  size_t component_bytes = 0;
+};
+
+std::optional<UxrOpaqueAlpha> UxrOpaqueAlphaForColorType(SkColorType type) {
+  UxrOpaqueAlpha alpha;
+  switch (type) {
+    case kRGBA_8888_SkColorType:
+    case kBGRA_8888_SkColorType:
+      alpha.bytes[0] = 255;
+      alpha.component_bytes = 1;
+      break;
+    case kRGBA_F16_SkColorType: {
+      const auto one = std::bit_cast<std::array<uint8_t, 2>>(uint16_t{0x3c00});
+      alpha.bytes[0] = one[0];
+      alpha.bytes[1] = one[1];
+      alpha.component_bytes = 2;
+      break;
+    }
+    case kRGBA_F32_SkColorType:
+      alpha.bytes = std::bit_cast<std::array<uint8_t, 4>>(1.0f);
+      alpha.component_bytes = 4;
+      break;
+    default:
+      return std::nullopt;
+  }
+  return alpha;
+}
