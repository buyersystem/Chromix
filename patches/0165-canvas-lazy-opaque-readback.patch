+// An unallocated opaque canvas still has logical opaque-black pixels. Readback
+// must initialize alpha only inside its bounds; OOB pixels/padding stay zero.
+// This writes the newly allocated ImageData, never a shared source resource.
+// A lost context is handled by the caller and retains the native lost path.
+bool UxrInitializeOpaqueReadback(const SkPixmap& destination,
+                                 int canvas_width,
+                                 int canvas_height,
+                                 int source_x,
+                                 int source_y) {
+  auto alpha_value = UxrOpaqueAlphaForColorType(destination.colorType());
+  if (!alpha_value || !destination.addr() || destination.info().isEmpty() ||
+      !destination.info().validRowBytes(destination.rowBytes()) ||
+      SkImageInfo::ByteSizeOverflowed(
+          destination.info().computeByteSize(destination.rowBytes()))) {
+    return false;
+  }
+  const int64_t left = std::max<int64_t>(0, source_x);
+  const int64_t top = std::max<int64_t>(0, source_y);
+  const int64_t right = std::min<int64_t>(
+      canvas_width, static_cast<int64_t>(source_x) + destination.width());
+  const int64_t bottom = std::min<int64_t>(
+      canvas_height, static_cast<int64_t>(source_y) + destination.height());
+  if (left >= right || top >= bottom)
+    return true;
+  SkPixmap clipped;
+  if (!destination.extractSubset(
+          &clipped,
+          SkIRect::MakeXYWH(static_cast<int>(left - source_x),
+                           static_cast<int>(top - source_y),
+                           static_cast<int>(right - left),
+                           static_cast<int>(bottom - top)))) {
+    return false;
+  }
+  auto bytes = gfx::SkPixmapToWritableSpan(clipped);
+  const size_t component_bytes = alpha_value->component_bytes;
+  const auto alpha = base::span(alpha_value->bytes).first(component_bytes);
+  for (int y = 0; y < clipped.height(); ++y) {
+    auto row = bytes.subspan(static_cast<size_t>(y) * clipped.rowBytes(),
+                            clipped.info().minRowBytes());
+    for (int x = 0; x < clipped.width(); ++x) {
+      row.subspan(static_cast<size_t>(x) * component_bytes * 4,
+                  component_bytes * 4)
+          .last(component_bytes)
+          .copy_from(alpha);
+    }
+  }
+  return true;
+}
